   "text": "Well how come you and Travis talk about it a lot?",
   "kind": "dialogue"
  },
  {
   "speaker": "BRENDAN:",
   "text": "He does it, but I don't do it.",
   "kind": "dialogue"
  },
  {
   "speaker": "WIEGERT:",
   "text": "You don't smoke anything?",
   "kind": "dialogue"
  },
  {
