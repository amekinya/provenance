   "text": "(shakes head \u201cno\u201d)",
   "kind": "dialogue"
  },
  {
   "speaker": "WIEGERT:",
   "text": "You smoke cigarettes?",
   "kind": "dialogue"
  },
  {
   "speaker": "BRENDAN:",
   "text": "No, (shakes head \u201cno\u201d) I tried it.",
   "kind": "dialogue"
  },
  {
   "speaker": "WIEGERT:",
   "text": "Yeah, did you try marijuana?",
   "kind": "dialogue"
  },
  {
   "speaker": "BRENDAN:",
   "text": "No.",
   "kind": "dialogue"
  },
  {
   "speaker": "WIEGERT:",
   "text": "Well, I heard that you smoke marijuana once in a while.",
   "kind": "dialogue"
  },
  {
   "speaker": "BRENDAN:",
   "text": "No.",
   "kind": "dialogue"
  },
  {
